{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "票图配置",
  "description": "指定票目录与表示交付完成的 status 值。",
  "type": "object",
  "required": ["tickets", "completion"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "供编辑器关联本结构定义；命令始终使用技能随附校验器。"
    },
    "tickets": {
      "type": "string",
      "pattern": "\\S",
      "description": "票目录的绝对路径，或相对于配置文件所在目录的路径。"
    },
    "completion": {
      "type": "object",
      "description": "票头固定使用 status，由项目指定哪些值表示交付完成。",
      "required": ["values"],
      "additionalProperties": false,
      "properties": {
        "values": {
          "type": "array",
          "minItems": 1,
          "description": "表示交付完成的非空白字符串；精确匹配，保留空白、大小写和重复项。",
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
