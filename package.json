{
  "private": true,
  "type": "module",
  "scripts": {
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix --ignore-pattern node_modules .",
    "lint:fix": "oxlint --format=unix . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck",
    "fix": "pnpm run lint:fix && pnpm run format:write"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript-7": "npm:typescript@^7.0.2"
  },
  "engines": {
    "node": "24.21.0"
  },
  "packageManager": "pnpm@12.9.1"
}
